# StockSense AI Environment Configuration
# Copy this file to .env and adjust values for your environment.

# Django Security
DEBUG=True
SECRET_KEY=stocksense-insecure-dev-key-change-this-in-production-1234567890
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Defaults to SQLite for local development)
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/stocksense_db
DATABASE_URL=sqlite:///db.sqlite3

# AI Research Assistant (Google Gemini API)
# Optional: Get your free API key at https://aistudio.google.com/
GEMINI_API_KEY=

# Optional Financial News API Keys (Yahoo Finance news used by default)
NEWS_API_KEY=

# Server Port
PORT=8000
