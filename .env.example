# ==============================================================================
# StockSense AI - Environment Configuration Template
# ==============================================================================
# In local development: Copy this file to .env and adjust values.
# On Render.com: Configure these keys under the Service "Environment" tab.

# Django Core & Security
DEBUG=False
SECRET_KEY=generate-a-secure-random-64-character-secret-key-for-production
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,http://localhost:8000

# Database Configuration (Render automatically sets DATABASE_URL when PostgreSQL is attached)
# Local SQLite fallback: sqlite:///db.sqlite3
# Production PostgreSQL example: postgresql://stocksense_user:password@dpg-xxx-a:5432/stocksense
DATABASE_URL=sqlite:///db.sqlite3

# External AI Services (Optional)
# Google Gemini API key: https://aistudio.google.com/
GEMINI_API_KEY=

# NewsAPI.org API key: https://newsapi.org/ (Optional; Google News RSS works by default with 0 keys)
NEWS_API_KEY=

# Server Port (Render sets this dynamically)
PORT=8000
